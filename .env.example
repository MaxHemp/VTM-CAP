# ── VTM Studio – Umgebungsvariablen ─────────────────────────────────────────
# Diese Datei nach .env kopieren und Werte eintragen. Die .env wird niemals
# committet (siehe .gitignore). In GitHub Actions kommen die Werte aus
# Actions-Secrets; die Integrationstests provisionieren sich ihre
# Ghost-Zugangsdaten selbst und brauchen keine echten Keys.

# PostgreSQL-Verbindung (produktiv Neon-kompatibel, lokal z. B. via docker-compose)
DATABASE_URL="postgresql://vtm:vtm@localhost:5432/vtm_studio"

# Auth.js: Zufallswert, z. B. mit `openssl rand -base64 32` erzeugen
AUTH_SECRET="bitte-ersetzen"

# Schlüssel für die AES-256-GCM-Verschlüsselung der in der Datenbank
# abgelegten API-Keys (Einstellungen). Unabhängig von AUTH_SECRET wählen.
ENCRYPTION_SECRET="bitte-ersetzen"

# Basis-URL der App (für Magic-Links und absolute Links). Auf Vercel optional:
# ohne APP_URL wird automatisch die Produktions-Domain des Projekts verwendet.
APP_URL="http://localhost:3000"

# Seed-Steuerung (Deployment): SEED_ON_BUILD=1 führt `prisma db seed` beim
# Vercel-Build aus (idempotent; Beispielartikel nur in eine leere Datenbank).
# SEED_ADMIN_EMAIL legt den ersten Herausgeber-Zugang an bzw. hebt dessen
# Rolle an – wichtig, da die Anmeldung auf hinterlegte Benutzer beschränkt ist.
SEED_ON_BUILD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""

# Anthropic API (Card-Generierung, Qualitätsscore, Faktencheck)
# Der Key kann alternativ über die Einstellungsseite verschlüsselt in der
# Datenbank hinterlegt werden.
ANTHROPIC_API_KEY=""

# MOCK_KI=1 aktiviert die deterministische Mock-KI ohne API-Key
# (Entwicklung, CI, E2E-Tests). Leer lassen für den Produktivbetrieb.
MOCK_KI=""

# Ghost Admin API (Draft-Erstellung, Image-Upload – ab M3).
# GHOST_URL ohne abschließenden Slash, z. B. https://mein-magazin.ghost.io
# GHOST_ADMIN_API_KEY im Format "id:secret" aus Ghost Admin → Integrationen.
# Beides kann alternativ über die Einstellungsseite gepflegt werden.
GHOST_URL=""
GHOST_ADMIN_API_KEY=""

# SMTP für Magic-Link-E-Mails (Auth) und Benachrichtigungen.
# Ohne SMTP_HOST wird der Magic-Link in der Server-Konsole ausgegeben
# (Entwicklungsmodus).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="VTM Studio <studio@example.com>"
